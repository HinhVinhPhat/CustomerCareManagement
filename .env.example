# Copy to .env and change the values. Do NOT commit the .env file (it is in .gitignore).
#
# SA_PASSWORD   password of the SQL Server "sa" account - used only inside the db-init container to
#               create the database and the application login. Never given to the web service.
# APP_PASSWORD  password of the app_ccm login the web application uses, and the password inside
#               ConnectionStrings__DefaultConnection of the web service.
#
# Both must be at least 8 characters with upper case, lower case, digits and symbols (SQL Server
# CHECK_POLICY is on). APP_PASSWORD is also written into the connection string and into SQL text, so
# it must NOT contain:  '   ;   $   and must not contain the characters  }   ]   either.
#
# Changing APP_PASSWORD after the first run does not change the login that already exists;
# recreate everything with:  docker compose down -v && docker compose up -d --build
# (down -v deletes the data and the Data Protection keys, so everybody signs in again.)
SA_PASSWORD=ChangeMe_Str0ng!Pass
APP_PASSWORD=App_Str0ng!Pass2026
