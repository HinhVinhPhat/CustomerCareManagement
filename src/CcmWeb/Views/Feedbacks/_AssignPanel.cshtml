@model FeedbackDetailViewModel
<section class="card p-5">
    <h2 class="font-semibold">@L["Feedback_AssignTitle"]</h2>
    <p class="text-sm text-muted mt-1">@L["Feedback_AssignHint"]</p>

    <form method="post" action="/feedbacks/@Model.FeedbackId/assign" class="mt-4">
        @Html.AntiForgeryToken()
        <label class="block text-sm font-semibold mb-1" for="assignEmployee">@L["Feedback_AssignedTo"]</label>
        <select id="assignEmployee" name="employeeId" class="input" required>
            <option value="">@L["Feedback_ChooseAssignee"]</option>
            @foreach (var employee in Model.Staff)
            {
                <option value="@employee.EmployeeId" selected="@(employee.EmployeeId == Model.EmployeeId)">@employee.FullName</option>
            }
        </select>

        <button type="submit" class="btn btn-primary mt-4">
            <i class="fa-solid fa-user-check"></i>
            @(Model.EmployeeId is null ? L["Feedback_Assign"] : L["Feedback_Reassign"])
        </button>
    </form>
</section>
