@model FeedbackListViewModel
@{
    var returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;
}
<dialog id="assignDialog" class="confirm-dialog card p-5">
    <h2 class="font-semibold">@L["Feedback_AssignTitle"]</h2>
    <p class="text-sm text-muted mt-1">@L["Feedback_AssignHint"]</p>

    <form id="assignForm" method="post" action="/feedbacks/0/assign" class="mt-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <label class="block text-sm font-semibold mb-1" for="assignEmployee">@L["Feedback_AssignedTo"]</label>
        <select id="assignEmployee" name="employeeId" class="input" required>
            <option value="">@L["Feedback_ChooseAssignee"]</option>
            @foreach (var employee in Model.Staff)
            {
                <option value="@employee.EmployeeId">@employee.FullName</option>
            }
        </select>

        <div class="flex justify-end gap-2 mt-4">
            <button type="button" class="btn" data-close-assign>@L["Common_Cancel"]</button>
            <button type="submit" class="btn btn-primary">@L["Common_Confirm"]</button>
        </div>
    </form>
</dialog>
