@model FeedbackDetailViewModel
@{
    ViewData["Title"] = L["Feedback_DetailTitle", Model.FeedbackId];
    ViewData["PageKey"] = "feedback";
}
<header class="flex flex-wrap items-start justify-between gap-3 mb-5">
    <div class="min-w-0">
        <a href="/feedbacks" class="text-sm text-muted">
            <i class="fa-solid fa-arrow-left"></i> @L["Feedback_Back"]
        </a>
        <h1 class="text-2xl font-bold mt-1">@L["Feedback_DetailTitle", Model.FeedbackId]</h1>
    </div>

    <div class="flex flex-wrap items-center gap-2">
        <partial name="_Badge" model="BadgeModel.Priority(Model.Priority)" />
        <partial name="_Badge" model="BadgeModel.FeedbackStatus(Model.FeedbackStatus)" />
    </div>
</header>

<partial name="_FeedbackSummary" model="Model" />

<div class="grid gap-4 lg:grid-cols-2 mt-4">
    <partial name="_AssignPanel" model="Model" />
    <partial name="_StatusPanel" model="Model" />
</div>

<partial name="_NotePanel" model="Model" />
