@model FeedbackCreateViewModel
<form method="post" action="/feedbacks/create" class="space-y-5">
    @Html.AntiForgeryToken()

    <section class="card p-5">
        <h2 class="font-semibold mb-4">@L["Feedback_GeneralInfo"]</h2>

        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <label asp-for="CustomerId" class="block text-sm font-semibold mb-1"></label>
                <select asp-for="CustomerId" class="input">
                    <option value="">@L["Feedback_ChooseCustomer"]</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.CustomerId">@customer.CustomerName</option>
                    }
                </select>
                <span asp-validation-for="CustomerId" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div>
                <label asp-for="FeedbackType" class="block text-sm font-semibold mb-1"></label>
                <select asp-for="FeedbackType" class="input">
                    <option value="">@L["Feedback_ChooseType"]</option>
                    @foreach (var type in WorkConstants.FeedbackTypes.All)
                    {
                        <option value="@type">@L.Label("FeedbackType", type)</option>
                    }
                </select>
                <span asp-validation-for="FeedbackType" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div>
                <label asp-for="Priority" class="block text-sm font-semibold mb-1"></label>
                <select asp-for="Priority" class="input">
                    @foreach (var priority in WorkConstants.FeedbackPriorities.All)
                    {
                        <option value="@priority">@L.Label("Priority", priority.ToString())</option>
                    }
                </select>
                <span asp-validation-for="Priority" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div>
                <label asp-for="DueDate" class="block text-sm font-semibold mb-1"></label>
                <input asp-for="DueDate" type="date" class="input" />
                <p class="text-xs text-muted mt-1">@L["Feedback_DueDateHint"]</p>
                <span asp-validation-for="DueDate" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div class="md:col-span-2">
                <label asp-for="Content" class="block text-sm font-semibold mb-1"></label>
                <textarea asp-for="Content" class="input" rows="5" maxlength="2000"></textarea>
                <span asp-validation-for="Content" class="block text-sm text-danger-ink min-h-5"></span>
            </div>
        </div>
    </section>

    <div asp-validation-summary="ModelOnly" class="text-sm text-danger-ink"></div>

    <div class="flex items-center gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> @L["Common_Save"]
        </button>
        <a href="/feedbacks" class="btn">@L["Common_Cancel"]</a>
    </div>
</form>
