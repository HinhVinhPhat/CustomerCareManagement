@model FeedbackListViewModel
@{
    void SortHeader(string field, string labelKey)
    {
        var isCurrent = Model.Filter.Sort == field;
        var icon = !isCurrent ? "fa-sort" : (Model.Filter.Desc ? "fa-sort-down" : "fa-sort-up");

        <th>
            <a href="/feedbacks@(Model.Filter.SortQuery(field))" class="inline-flex items-center gap-1">
                <span>@L[labelKey]</span>
                <i class="fa-solid @icon @(isCurrent ? null : "text-muted")" aria-hidden="true"></i>
            </a>
        </th>
    }
}
<div class="overflow-x-auto">
    <table class="tbl tbl-cards">
        <thead>
            <tr>
                @{
                    SortHeader(FeedbackFilter.SortByPriority, "Feedback_Priority");
                    SortHeader(FeedbackFilter.SortByCustomer, "Common_Customer");
                }
                <th>@L["Feedback_Type"]</th>
                <th>@L["Feedback_Content"]</th>
                <th>@L["Feedback_Status"]</th>
                <th>@L["Feedback_AssignedTo"]</th>
                @{
                    SortHeader(FeedbackFilter.SortByDueDate, "Feedback_DueDate");
                }
                <th class="text-right">@L["Common_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <partial name="_FeedbackRow" model="row" />
            }
        </tbody>
    </table>
</div>
