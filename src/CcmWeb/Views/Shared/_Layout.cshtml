@inject ISettingService Settings
@{
    // The theme is a display state, so it is resolved once here: cookie first, then the system
    // default from SETTINGS, then "light". The language already comes from CultureInfo, which
    // UseRequestLocalization filled from the same sources.
    var theme = await Settings.ResolveThemeAsync();
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@language" data-theme="@theme">
<head>
    <partial name="_HeadAssets" />
</head>
<body class="min-h-screen" data-page="@ViewData["PageKey"]">
    <partial name="_Sidebar" />

    <div class="lg:pl-64 min-h-screen flex flex-col">
        <partial name="_Topbar" />

        <main class="p-4 lg:p-6 w-full max-w-[1440px] mx-auto">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
