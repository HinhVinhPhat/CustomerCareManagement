@model CustomerListViewModel
@{
    // A clickable column header. Clicking the column the list is already sorted by turns the
    // direction around; the arrow shows which way the rows are ordered right now.
    void SortHeader(string field, string labelKey, string cellClass = "")
    {
        var isCurrent = Model.Filter.Sort == field;
        var icon = !isCurrent ? "fa-sort" : (Model.Filter.Desc ? "fa-sort-down" : "fa-sort-up");

        <th class="@cellClass">
            @* The link always carries the path: a plain sort of a plain list is simply /customers. *@
            <a href="/customers@(Model.Filter.SortQuery(field))" class="inline-flex items-center gap-1">
                <span>@L[labelKey]</span>
                <i class="fa-solid @icon @(isCurrent ? null : "text-muted")" aria-hidden="true"></i>
            </a>
        </th>
    }
}
<div class="overflow-x-auto">
    <table class="tbl tbl-cards">
        <thead>
            <tr>
                @{
                    SortHeader(CustomerFilter.SortByName, "Customer_Field_Name");
                    <th>@L["Customer_Field_Contact"]</th>
                    <th>@L["Customer_Field_Tier"]</th>
                    <th>@L["Customer_Field_Owner"]</th>
                    SortHeader(CustomerFilter.SortByTotalValue, "Customer_Field_TotalValue", "num");
                    SortHeader(CustomerFilter.SortByCreatedDate, "Customer_Field_CreatedDate");
                }
                <th class="text-right">@L["Common_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <partial name="_CustomerRow" model="row" />
            }
        </tbody>
    </table>
</div>
