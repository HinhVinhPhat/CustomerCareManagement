@model CustomerListViewModel
@{
    ViewData["Title"] = L["Nav_Customers"];
    ViewData["PageKey"] = "customers";

    // Adding and changing belong to Manager and Sales (design.md 5.1). Support sees the same pages
    // without these controls - and the actions behind them are protected on the server as well.
    var canEdit = User.IsInRole(WorkConstants.Roles.Manager) || User.IsInRole(WorkConstants.Roles.Sales);
}

<header class="flex items-center justify-between gap-3 mb-5">
    <h1 class="text-2xl font-bold">@L["Nav_Customers"]</h1>

    @if (canEdit)
    {
        <a href="/customers/create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> @L["Customer_Add"]
        </a>
    }
</header>

<partial name="_FilterBar" model="Model" />

@if (Model.ErrorKey is not null)
{
    @* A list that could not be read is not an empty list. *@
    <section class="card p-8 text-center">
        <i class="fa-solid fa-triangle-exclamation text-3xl text-danger-ink"></i>
        <p class="mt-3 font-semibold">@L[Model.ErrorKey]</p>
        <p class="text-sm text-muted mt-1">@L["Common_TryAgain"]</p>
    </section>
}
else if (Model.Rows.Count == 0)
{
    <partial name="_EmptyState" model="Model" />
}
else
{
    <section class="card overflow-hidden">
        <partial name="_CustomerTable" model="Model" />
        <partial name="_Pager" model="Model" />
    </section>
}
