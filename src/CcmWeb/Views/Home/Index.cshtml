@model DashboardViewModel
@{
    ViewData["Title"] = L["Nav_Dashboard"];
    ViewData["PageKey"] = "dashboard";
}

<header class="mb-5">
    <h1 class="text-2xl font-bold">@L["Nav_Dashboard"]</h1>
    <p class="text-sm text-muted mt-1">
        @L["Dashboard_SignedInAs", User.GetDisplayName(), L.Label("Role", User.GetRole())]
    </p>
</header>

@* Mỗi khối là một partial riêng: một khối lỗi không kéo theo các khối khác (AGENTS.md 5). *@
<partial name="Dashboard/_KpiCards" model="Model" />
<partial name="Dashboard/_YearPicker" model="Model" />

<div class="grid lg:grid-cols-3 gap-4 mb-4">
    <partial name="Dashboard/_RevenueChart" model="Model" />
    <partial name="Dashboard/_CareSchedule" model="Model" />
</div>

<div class="grid lg:grid-cols-3 gap-4">
    <partial name="Dashboard/_TopCustomers" model="Model" />
    <partial name="Dashboard/_ExpiringContracts" model="Model" />
    <partial name="Dashboard/_FeedbackToHandle" model="Model" />
</div>
