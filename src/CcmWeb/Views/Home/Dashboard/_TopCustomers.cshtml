@model DashboardViewModel
@* Vẽ theo vai trò, không theo danh sách: danh sách là null khi truy vấn hỏng, và khối vẫn phải hiện
   khóa lỗi của mình (bug-report B02). *@
@if (Model.ShowRevenue)
{
    <section class="card p-5">
        <div class="flex items-start justify-between gap-3 mb-3">
            <div>
                <h2 class="font-semibold">@L["Dashboard_TopCustomers"]</h2>
                <p class="text-sm text-muted">
                    @L["Dashboard_TopCustomersHint", WorkConstants.Dashboard.TopCustomerCount]
                </p>
            </div>

            <a href="/reports/customers" class="text-sm text-primary whitespace-nowrap">
                @L["Common_ViewAll"]
            </a>
        </div>

        @if (Model.TopCustomersErrorKey is not null)
        {
            <partial name="_BlockError" model="Model.TopCustomersErrorKey" />
        }
        else if (Model.TopCustomers is null || Model.TopCustomers.Count == 0)
        {
            <p class="text-sm text-muted py-4">@L["Dashboard_NoTopCustomers"]</p>
        }
        else
        {
            <ul class="divide-y divide-line">
                @foreach (var customer in Model.TopCustomers)
                {
                    <li class="py-2.5 flex items-center justify-between gap-3">
                        <div class="min-w-0">
                            <a href="/customers/@customer.CustomerId" class="font-medium truncate block">
                                @customer.CustomerName
                            </a>
                            <div class="mt-1">
                                <partial name="_Badge" model="BadgeModel.Tier(customer.Tier)" />
                            </div>
                        </div>
                        <div class="shrink-0 text-right num font-semibold">
                            @Utils.FormatMoney(customer.TotalValue)
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}
