@model DashboardViewModel
<section class="card p-5">
    <div class="flex items-start justify-between gap-3 mb-3">
        <h2 class="font-semibold">@L["Dashboard_ExpiringTitle"]</h2>
        <a href="/contracts?expiring=true" class="text-sm text-primary whitespace-nowrap">
            @L["Common_ViewAll"]
        </a>
    </div>

    @if (Model.ExpiringErrorKey is not null)
    {
        <partial name="_BlockError" model="Model.ExpiringErrorKey" />
    }
    else if (Model.Expiring.Count == 0)
    {
        <p class="text-sm text-muted py-4">@L["Dashboard_NoExpiring"]</p>
    }
    else
    {
        <ul class="divide-y divide-line">
            @foreach (var contract in Model.Expiring)
            {
                var urgent = contract.DaysRemaining <= 7;

                <li class="py-2.5 flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <a href="/customers/@contract.CustomerId" class="font-medium truncate block">
                            @contract.CustomerName
                        </a>
                        <div class="text-sm text-muted">
                            <a href="/contracts/@contract.ContractId" class="hover:underline">
                                @L["Contract_Code"] @contract.ContractId
                            </a>
                            · @Utils.FormatDate(contract.EndDate)
                        </div>
                    </div>

                    <div class="shrink-0 text-right space-y-1">
                        <span class="badge @(urgent ? "b-danger" : "b-warning")">
                            @L["Contract_DaysRemaining", contract.DaysRemaining]
                        </span>

                        @if (Model.CanRenewContracts)
                        {
                            <a href="/contracts/@contract.ContractId" class="block text-sm text-primary">
                                @L["Contract_Renew"]
                            </a>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</section>
