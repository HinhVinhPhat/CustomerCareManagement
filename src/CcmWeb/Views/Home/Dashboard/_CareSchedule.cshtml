@model DashboardViewModel
<section class="card p-5">
    <div class="flex items-start justify-between gap-3 mb-3">
        <h2 class="font-semibold">@L["Dashboard_CareTitle"]</h2>
        <a href="/care" class="text-sm text-primary whitespace-nowrap">@L["Common_ViewAll"]</a>
    </div>

    @if (Model.CareErrorKey is not null)
    {
        <partial name="_BlockError" model="Model.CareErrorKey" />
    }
    else if (Model.Care.Total == 0)
    {
        <p class="text-sm text-muted py-4">@L["Dashboard_NoCare"]</p>
    }
    else
    {
        var groups = new[]
        {
            (Status: WorkConstants.ScheduleStatus.Overdue, Rows: Model.Care.Overdue),
            (Status: WorkConstants.ScheduleStatus.Today, Rows: Model.Care.Today),
            (Status: WorkConstants.ScheduleStatus.Upcoming, Rows: Model.Care.Upcoming)
        };

        @foreach (var group in groups)
        {
            if (group.Rows.Count == 0)
            {
                continue;
            }

            <div class="mb-2">
                <div class="flex items-center justify-between gap-2 mb-1">
                    <h3 class="text-sm font-semibold">
                        <partial name="_Badge" model="BadgeModel.ScheduleStatus(group.Status)" />
                    </h3>
                    <span class="text-xs text-muted">@group.Rows.Count</span>
                </div>

                <ul class="divide-y divide-line">
                    @foreach (var item in group.Rows)
                    {
                        <li class="py-2 flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <a href="/customers/@item.CustomerId" class="font-medium truncate block">
                                    @item.CustomerName
                                </a>
                                <div class="text-sm text-muted">
                                    @L.Label("CareType", item.CareType) · @Utils.FormatDate(item.NextAppointmentDate)
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</section>
