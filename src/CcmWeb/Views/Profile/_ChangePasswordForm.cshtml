@model ChangePasswordViewModel
@* Your own account: the old password is required, unlike a Manager's reset, because this screen is
   reachable by anyone who happens to walk past a signed-in browser. *@
<form method="post" asp-controller="Profile" asp-action="ChangePassword" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-danger-ink mb-4 empty:hidden"></div>

    <div class="grid gap-4 md:grid-cols-3">
        <div>
            <label asp-for="CurrentPassword" class="block text-sm font-semibold mb-1"></label>
            <input asp-for="CurrentPassword" class="input" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="block text-sm text-danger-ink min-h-5"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="block text-sm font-semibold mb-1"></label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" />
            <span class="block text-xs text-muted mt-1">@L["Password_LengthHint"]</span>
            <span asp-validation-for="NewPassword" class="block text-sm text-danger-ink min-h-5"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-semibold mb-1"></label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="block text-sm text-danger-ink min-h-5"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-2">
        <i class="fa-solid fa-key"></i> @L["Password_Change"]
    </button>
</form>
