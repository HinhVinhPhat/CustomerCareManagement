@model CareLogViewModel
@{
    var canCreate = User.IsInRole(WorkConstants.Roles.Manager) || User.IsInRole(WorkConstants.Roles.Support);
    var pastEnd = Model.Filter.Page > 1;
    var narrowed = Model.Filter.HasFilters;
}
<section class="card p-8 text-center">
    <i class="fa-solid @(pastEnd ? "fa-file-circle-question" : narrowed ? "fa-magnifying-glass" : "fa-heart") text-3xl text-muted"
       aria-hidden="true"></i>

    @if (pastEnd)
    {
        <p class="mt-3 font-semibold">@L["Care_NoPage"]</p>
        <p class="text-sm text-muted mt-1">@L["Care_NoPageHint"]</p>
        <a href="/care@(Model.Filter.PageQuery(1))" class="btn btn-primary mt-4">
            <i class="fa-solid fa-arrow-left"></i> @L["Common_FirstPage"]
        </a>
    }
    else if (narrowed)
    {
        <p class="mt-3 font-semibold">@L["Care_NoMatch"]</p>
        <p class="text-sm text-muted mt-1">@L["Care_NoMatchHint"]</p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
            <a href="/care?tab=log" class="btn">
                <i class="fa-solid fa-filter-circle-xmark"></i> @L["Common_ClearFilters"]
            </a>
            @if (canCreate)
            {
                <a href="/care/create?returnUrl=@Uri.EscapeDataString("/care?tab=log")" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> @L["Care_Add"]
                </a>
            }
        </div>
    }
    else
    {
        <p class="mt-3 font-semibold">@L["Care_NoneYet"]</p>
        <p class="text-sm text-muted mt-1">@L["Care_NoneYetHint"]</p>
        @if (canCreate)
        {
            <a href="/care/create?returnUrl=@Uri.EscapeDataString("/care?tab=log")" class="btn btn-primary mt-4">
                <i class="fa-solid fa-plus"></i> @L["Care_Add"]
            </a>
        }
    }
</section>
