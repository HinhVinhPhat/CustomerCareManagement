@model CareLogViewModel
@{
    var filter = Model.Filter;
}
<form method="get" action="/care" class="card p-4 mb-4 grid gap-3 md:grid-cols-12 items-end">
    <input type="hidden" name="tab" value="log" />

    <div class="md:col-span-3">
        <label class="block text-sm font-semibold mb-1" for="q">@L["Care_SearchLabel"]</label>
        <input id="q" name="q" value="@filter.Q" class="input"
               placeholder="@L["Care_SearchPlaceholder"]" autocomplete="off" />
    </div>

    <div class="md:col-span-3">
        <label class="block text-sm font-semibold mb-1" for="staff">@L["Common_Staff"]</label>
        <select id="staff" name="staff" class="input">
            <option value="">@L["Care_AllStaff"]</option>
            @foreach (var employee in Model.Staff)
            {
                <option value="@employee.EmployeeId" selected="@(employee.EmployeeId == filter.Staff)">@employee.FullName</option>
            }
        </select>
    </div>

    <div class="md:col-span-2">
        <label class="block text-sm font-semibold mb-1" for="type">@L["Care_Type"]</label>
        <select id="type" name="type" class="input">
            <option value="">@L["Care_AllTypes"]</option>
            @foreach (var type in WorkConstants.CareTypes.All)
            {
                <option value="@type" selected="@(type == filter.CareType)">@L.Label("CareType", type)</option>
            }
        </select>
    </div>

    <div class="md:col-span-2">
        <label class="block text-sm font-semibold mb-1" for="from">@L["Common_FromDate"]</label>
        <input id="from" name="from" type="date" class="input"
               value="@(filter.From?.ToString("yyyy-MM-dd"))" />
    </div>

    <div class="md:col-span-2">
        <label class="block text-sm font-semibold mb-1" for="to">@L["Common_ToDate"]</label>
        <input id="to" name="to" type="date" class="input"
               value="@(filter.To?.ToString("yyyy-MM-dd"))" />
    </div>

    @if (filter.Sort != CareFilter.SortByCareDate)
    {
        <input type="hidden" name="sort" value="@filter.Sort" />
    }
    @if (!filter.Desc)
    {
        <input type="hidden" name="desc" value="false" />
    }
    @if (filter.PageSize != WorkConstants.Settings.DefaultPageSize)
    {
        <input type="hidden" name="pageSize" value="@filter.PageSize" />
    }

    <div class="md:col-span-12 flex items-center gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i> @L["Common_Search"]
        </button>

        @if (filter.HasFilters)
        {
            <a href="/care?tab=log" class="btn">
                <i class="fa-solid fa-filter-circle-xmark"></i> @L["Common_ClearFilters"]
            </a>
        }
    </div>
</form>
