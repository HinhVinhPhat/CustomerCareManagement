@model ContactListViewModel
@{
    var form = Model.Form ?? new ContactFormViewModel { Customers = Model.Customers };
}
<dialog id="contactDialog" class="confirm-dialog dialog-wide card p-5"
        data-contact-dialog data-open="@(Model.OpenDialog ? "true" : "false")">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h2 class="font-semibold">@L["Contact_Add"]</h2>
            <p class="text-sm text-muted mt-1">@L["Contact_AddHint"]</p>
        </div>
        <button type="button" class="btn !py-1 !px-2.5" data-close-contact
                aria-label="@L["Common_Cancel"]">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <partial name="_ContactForm" model="form" />
</dialog>
