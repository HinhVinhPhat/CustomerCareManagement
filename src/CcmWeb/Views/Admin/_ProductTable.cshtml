@model ProductListViewModel
@{
    var filter = Model.Filter;

    // A clickable column header; clicking the column already sorted turns the direction around.
    void SortHeader(string field, string labelKey, string cellClass = "")
    {
        var isCurrent = filter.Sort == field;
        var icon = !isCurrent ? "fa-sort" : (filter.Desc ? "fa-sort-down" : "fa-sort-up");

        <th class="@cellClass">
            <a href="/admin/products@(filter.SortQuery(field))" class="inline-flex items-center gap-1">
                <span>@L[labelKey]</span>
                <i class="fa-solid @icon @(isCurrent ? null : "text-muted")" aria-hidden="true"></i>
            </a>
        </th>
    }
}
<div class="overflow-x-auto">
    <table class="tbl tbl-cards">
        <thead>
            <tr>
                @{
                    SortHeader(ProductFilter.SortByName, "Product_Name");
                    <th>@L["Product_Type"]</th>
                    SortHeader(ProductFilter.SortByPrice, "Product_UnitPrice", "num");
                    <th>@L["Product_Description"]</th>
                    <th class="text-right">@L["Common_Actions"]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td data-label="@L["Product_Name"]" class="font-semibold">@row.ProductName</td>
                    <td data-label="@L["Product_Type"]">
                        <partial name="_Badge" model="@(new BadgeModel("ProductType", row.ProductType, "b-info"))" />
                    </td>
                    <td data-label="@L["Product_UnitPrice"]" class="num">@Utils.FormatMoney(row.UnitPrice)</td>
                    <td data-label="@L["Product_Description"]" class="text-muted">
                        <span class="block max-w-xs truncate">@row.Description</span>
                    </td>
                    <td data-label="@L["Common_Actions"]" class="text-right whitespace-nowrap">
                        @if (Model.CanEdit)
                        {
                            <a href="/admin/products/@row.ProductId/edit" class="btn !py-1 !px-2 !text-xs"
                               title="@L["Common_Edit"]">
                                <i class="fa-solid fa-pen"></i> @L["Common_Edit"]
                            </a>

                            @if (row.UsageCount == 0)
                            {
                                <form method="post" action="/admin/products/@row.ProductId/delete" class="inline"
                                      data-confirm
                                      data-confirm-title="@L["Product_DeleteTitle"]"
                                      data-confirm-body="@L["Product_DeleteBody", row.ProductName]">
                                    <button type="submit" class="btn btn-danger !py-1 !px-2 !text-xs">
                                        <i class="fa-solid fa-trash"></i> @L["Common_Delete"]
                                    </button>
                                </form>
                            }
                            else
                            {
                                @* A product that a contract already contains is never deleted. *@
                                <span class="text-xs text-muted" title="@L["Product_InUseHint"]">
                                    <i class="fa-solid fa-lock"></i> @L["Product_InUse", row.UsageCount]
                                </span>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
