@model ResetPasswordViewModel
@{
    ViewData["Title"] = L["Account_ResetPassword"];
    ViewData["PageKey"] = "administration";
}
<header class="mb-5">
    <a href="/admin/accounts" class="text-sm text-muted">
        <i class="fa-solid fa-arrow-left"></i> @L["Account_BackToList"]
    </a>
    <h1 class="text-2xl font-bold mt-1">@L["Account_ResetPassword"]</h1>
</header>

<form method="post" asp-controller="AdminAccounts" asp-action="Password"
      asp-route-id="@Model.AccountId" class="card p-5 max-w-2xl">
    <div asp-validation-summary="ModelOnly" class="text-sm text-danger-ink mb-4 empty:hidden"></div>

    <p class="text-sm text-muted mb-4">
        @L["Account_ResetPasswordFor", Model.Username, Model.EmployeeName]
    </p>

    <div class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="Password" class="block text-sm font-semibold mb-1"></label>
            <input asp-for="Password" class="input" autocomplete="new-password" />
            <span class="block text-xs text-muted mt-1">@L["Password_LengthHint"]</span>
            <span asp-validation-for="Password" class="block text-sm text-danger-ink min-h-5"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-semibold mb-1"></label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="block text-sm text-danger-ink min-h-5"></span>
        </div>
    </div>

    <div class="flex items-center gap-2 mt-6 pt-4 border-t border-line">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-key"></i> @L["Account_ResetPassword"]
        </button>
        <a href="/admin/accounts" class="btn">@L["Common_Cancel"]</a>
    </div>
</form>
