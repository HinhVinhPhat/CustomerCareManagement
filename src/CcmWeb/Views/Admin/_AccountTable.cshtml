@model AccountListViewModel
@{
    var filter = Model.Filter;
    var actorAccountId = User.GetAccountID();

    // A clickable column header; clicking the column already sorted turns the direction around.
    void SortHeader(string field, string labelKey, string cellClass = "")
    {
        var isCurrent = filter.Sort == field;
        var icon = !isCurrent ? "fa-sort" : (filter.Desc ? "fa-sort-down" : "fa-sort-up");

        <th class="@cellClass">
            <a href="/admin/accounts@(filter.SortQuery(field))" class="inline-flex items-center gap-1">
                <span>@L[labelKey]</span>
                <i class="fa-solid @icon @(isCurrent ? null : "text-muted")" aria-hidden="true"></i>
            </a>
        </th>
    }
}
<div class="overflow-x-auto">
    <table class="tbl tbl-cards">
        <thead>
            <tr>
                @{
                    SortHeader(AccountFilter.SortByUsername, "Account_Username");
                    SortHeader(AccountFilter.SortByEmployee, "Account_Employee");
                    <th>@L["Account_Role"]</th>
                    <th>@L["Account_State"]</th>
                    <th class="text-right">@L["Common_Actions"]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td data-label="@L["Account_Username"]" class="font-semibold">
                        @row.Username
                        @if (row.AccountId == actorAccountId)
                        {
                            <span class="text-xs text-muted block font-normal">@L["Account_ThisIsYou"]</span>
                        }
                    </td>
                    <td data-label="@L["Account_Employee"]">@row.EmployeeName</td>
                    <td data-label="@L["Account_Role"]">
                        <partial name="_Badge" model="@(new BadgeModel("Role", row.Role,
                            row.Role == WorkConstants.Roles.Manager ? "b-warning" : "b-info"))" />
                    </td>
                    <td data-label="@L["Account_State"]">
                        <partial name="_Badge" model="@(new BadgeModel("AccountState",
                            row.IsActive ? "Active" : "Locked", Badges.ForAccountState(row.IsActive)))" />
                    </td>
                    <td data-label="@L["Common_Actions"]" class="text-right whitespace-nowrap">
                        <a href="/admin/accounts/@row.AccountId/edit" class="btn !py-1 !px-2 !text-xs"
                           title="@L["Common_Edit"]">
                            <i class="fa-solid fa-pen"></i> @L["Common_Edit"]
                        </a>
                        <a href="/admin/accounts/@row.AccountId/password" class="btn !py-1 !px-2 !text-xs"
                           title="@L["Account_ResetPassword"]">
                            <i class="fa-solid fa-key"></i> @L["Account_ResetPassword"]
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
