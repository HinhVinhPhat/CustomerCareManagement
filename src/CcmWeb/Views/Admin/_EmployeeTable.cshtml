@model EmployeeListViewModel
@{
    var filter = Model.Filter;

    // A clickable column header; clicking the column already sorted turns the direction around.
    void SortHeader(string field, string labelKey, string cellClass = "")
    {
        var isCurrent = filter.Sort == field;
        var icon = !isCurrent ? "fa-sort" : (filter.Desc ? "fa-sort-down" : "fa-sort-up");

        <th class="@cellClass">
            <a href="/admin/employees@(filter.SortQuery(field))" class="inline-flex items-center gap-1">
                <span>@L[labelKey]</span>
                <i class="fa-solid @icon @(isCurrent ? null : "text-muted")" aria-hidden="true"></i>
            </a>
        </th>
    }
}
<div class="overflow-x-auto">
    <table class="tbl tbl-cards">
        <thead>
            <tr>
                @{
                    SortHeader(EmployeeFilter.SortByName, "Employee_FullName");
                    <th>@L["Employee_Contact"]</th>
                    SortHeader(EmployeeFilter.SortByDepartment, "Employee_Department");
                    <th>@L["Employee_Position"]</th>
                    <th>@L["Account_Title"]</th>
                    <th class="text-right">@L["Common_Actions"]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td data-label="@L["Employee_FullName"]" class="font-semibold">
                        @row.FullName
                        <span class="block text-xs text-muted font-normal">@L.Label("EmployeeGender", row.Gender)</span>
                    </td>
                    <td data-label="@L["Employee_Contact"]">
                        <span class="block">@row.Email</span>
                        <span class="block text-xs text-muted">@row.Phone</span>
                    </td>
                    <td data-label="@L["Employee_Department"]">@row.DepartmentName</td>
                    <td data-label="@L["Employee_Position"]">
                        <partial name="_Badge" model="@(new BadgeModel("Position", row.Position,
                            row.Position == WorkConstants.Positions.Manager ? "b-warning" : "b-neutral"))" />
                    </td>
                    <td data-label="@L["Account_Title"]">
                        @if (row.HasAccount)
                        {
                            <span class="badge b-success"><i class="fa-solid fa-key" aria-hidden="true"></i> @L["Employee_HasAccount"]</span>
                        }
                        else
                        {
                            <a href="/admin/accounts/create?employeeId=@row.EmployeeId" class="text-sm">
                                <i class="fa-solid fa-plus"></i> @L["Employee_CreateAccount"]
                            </a>
                        }
                    </td>
                    <td data-label="@L["Common_Actions"]" class="text-right whitespace-nowrap">
                        <a href="/admin/employees/@row.EmployeeId/edit" class="btn !py-1 !px-2 !text-xs"
                           title="@L["Common_Edit"]">
                            <i class="fa-solid fa-pen"></i> @L["Common_Edit"]
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
