@model AccountCreateViewModel
@{
    ViewData["Title"] = L["Account_Add"];
    ViewData["PageKey"] = "administration";
}
<header class="mb-5">
    <a href="/admin/accounts" class="text-sm text-muted">
        <i class="fa-solid fa-arrow-left"></i> @L["Account_BackToList"]
    </a>
    <h1 class="text-2xl font-bold mt-1">@L["Account_Add"]</h1>
</header>

@if (Model.Employees.Count == 0)
{
    @* Every employee already has an account: ACCOUNT.EmployeeID is UNIQUE, so there is nothing to add. *@
    <section class="card p-8 text-center">
        <i class="fa-solid fa-key text-3xl text-muted" aria-hidden="true"></i>
        <p class="mt-3 font-semibold">@L["Account_AllEmployeesHaveAccount"]</p>
        <p class="text-sm text-muted mt-1">@L["Account_AllEmployeesHaveAccountHint"]</p>
        <a href="/admin/employees/create" class="btn btn-primary mt-4">
            <i class="fa-solid fa-user-plus"></i> @L["Employee_Add"]
        </a>
    </section>
}
else
{
    <form method="post" asp-controller="AdminAccounts" asp-action="Create" class="card p-5 max-w-3xl">
        <div asp-validation-summary="ModelOnly" class="text-sm text-danger-ink mb-4 empty:hidden"></div>

        <div class="grid gap-4 md:grid-cols-2">
            <div class="md:col-span-2">
                <label asp-for="EmployeeId" class="block text-sm font-semibold mb-1"></label>
                <select asp-for="EmployeeId" class="input">
                    <option value="">@L["Account_Employee_Unset"]</option>
                    @foreach (var employee in Model.Employees)
                    {
                        <option value="@employee.EmployeeId">
                            @employee.FullName — @L.Label("Position", employee.Position)
                        </option>
                    }
                </select>
                <span asp-validation-for="EmployeeId" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div>
                <label asp-for="Username" class="block text-sm font-semibold mb-1"></label>
                <input asp-for="Username" class="input" autocomplete="off" />
                <span class="block text-xs text-muted mt-1">@L["Account_UsernameHint"]</span>
                <span asp-validation-for="Username" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div>
                <label asp-for="Role" class="block text-sm font-semibold mb-1"></label>
                <select asp-for="Role" class="input">
                    <option value="">@L["Account_Role_Unset"]</option>
                    @foreach (var role in WorkConstants.Roles.All)
                    {
                        <option value="@role">@L.Label("Role", role)</option>
                    }
                </select>
                <span asp-validation-for="Role" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-semibold mb-1"></label>
                <input asp-for="Password" class="input" autocomplete="new-password" />
                <span class="block text-xs text-muted mt-1">@L["Password_LengthHint"]</span>
                <span asp-validation-for="Password" class="block text-sm text-danger-ink min-h-5"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-semibold mb-1"></label>
                <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="block text-sm text-danger-ink min-h-5"></span>
            </div>
        </div>

        <div class="flex items-center gap-2 mt-6 pt-4 border-t border-line">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> @L["Common_Save"]
            </button>
            <a href="/admin/accounts" class="btn">@L["Common_Cancel"]</a>
        </div>
    </form>
}
