@model ContractListViewModel
@{
    void SortHeader(string field, string labelKey, string cellClass = "")
    {
        var isCurrent = Model.Filter.Sort == field;
        var icon = !isCurrent ? "fa-sort" : (Model.Filter.Desc ? "fa-sort-down" : "fa-sort-up");

        <th class="@cellClass">
            <a href="/contracts@(Model.Filter.SortQuery(field))" class="inline-flex items-center gap-1">
                <span>@L[labelKey]</span>
                <i class="fa-solid @icon @(isCurrent ? null : "text-muted")" aria-hidden="true"></i>
            </a>
        </th>
    }
}
<div class="overflow-x-auto">
    <table class="tbl tbl-cards">
        <thead>
            <tr>
                <th>@L["Contract_Code"]</th>
                @{ SortHeader(ContractFilter.SortByCustomerName, "Contract_Customer"); }
                <th>@L["Contract_Staff"]</th>
                @{ SortHeader(ContractFilter.SortBySignDate, "Contract_SignDate"); }
                @{ SortHeader(ContractFilter.SortByEndDate, "Contract_EndDate"); }
                @{ SortHeader(ContractFilter.SortByTotalValue, "Contract_Value", "num"); }
                <th>@L["Contract_Status"]</th>
                <th class="text-right">@L["Common_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <partial name="_ContractRow" model="row" />
            }
        </tbody>
    </table>
</div>
