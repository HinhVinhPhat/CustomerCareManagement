@model ContractListViewModel
@{
    ViewData["Title"] = L["Nav_Contracts"];
    ViewData["PageKey"] = "contracts";

    var canEdit = User.IsInRole(WorkConstants.Roles.Manager) || User.IsInRole(WorkConstants.Roles.Sales);
}
<header class="flex items-center justify-between gap-3 mb-5">
    <h1 class="text-2xl font-bold">@L["Nav_Contracts"]</h1>

    @if (canEdit)
    {
        <a href="/contracts/create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> @L["Contract_Add"]
        </a>
    }
</header>

<partial name="_FilterBar" model="Model" />

@if (Model.ErrorKey is not null)
{
    <section class="card p-8 text-center">
        <i class="fa-solid fa-triangle-exclamation text-3xl text-danger-ink"></i>
        <p class="mt-3 font-semibold">@L[Model.ErrorKey]</p>
        <p class="text-sm text-muted mt-1">@L["Common_TryAgain"]</p>
    </section>
}
else if (Model.Rows.Count == 0)
{
    <partial name="_EmptyState" model="Model" />
}
else
{
    <section class="card overflow-hidden">
        <partial name="_ContractTable" model="Model" />
        <partial name="_Pager" model="Model" />
    </section>
}
