@model CareReportViewModel
@{
    ViewData["Title"] = L["Nav_Reports"];
    ViewData["PageKey"] = "reports";

    var yearFilter = new YearFilterModel("/reports/care", Model.Year, Model.Years);
    var exportLink = new ExportLinkModel(
        $"/reports/care/export?year={Model.Year}", "Reports_ExportCare");
}
<header class="mb-5">
    <h1 class="text-2xl font-bold">@L["Nav_Reports"]</h1>
    <p class="text-sm text-muted mt-1">@L["Reports_Care_Subtitle"]</p>
</header>

<partial name="_Tabs" model="WorkConstants.Reports.TabCare" />

<div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <partial name="_YearFilter" model="yearFilter" />
    <partial name="_ExportButton" model="exportLink" />
</div>

@if (Model.ErrorKey is not null)
{
    <section class="card">
        <partial name="_BlockError" model="Model.ErrorKey" />
    </section>
}
else
{
    <section class="card p-5 mb-4">
        <div class="flex items-start justify-between gap-3 mb-4">
            <h2 class="font-semibold">@L["Reports_Care_Chart", Model.Year]</h2>
            <span class="text-sm text-muted">@L["Reports_Care_TotalVisits", Model.TotalVisits]</span>
        </div>

        @{
            var labels = Model.Rows
                .Select(row => CultureInfo.CurrentUICulture.DateTimeFormat.GetAbbreviatedMonthName(row.Month))
                .ToList();
            var values = Model.Rows.Select(row => (decimal)row.TotalVisits).ToList();
            var chart = new BarChartModel(
                L["Reports_Care_Chart", Model.Year].Value, labels, values, false);
        }

        <partial name="Charts/_BarChart" model="chart" />

        @if (!Model.HasData)
        {
            <p class="text-sm text-muted mt-3">@L["Reports_Care_NoData", Model.Year]</p>
        }
    </section>

    <section class="card overflow-hidden">
        <partial name="_CareTable" model="Model" />
    </section>
}