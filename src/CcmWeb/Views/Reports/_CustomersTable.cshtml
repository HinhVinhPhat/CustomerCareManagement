@model CustomerReportViewModel
@{
    void SortHeader(string field, string labelKey, string cellClass = "")
    {
        var isCurrent = Model.Filter.Sort == field;
        var icon = !isCurrent ? "fa-sort" : (Model.Filter.Desc ? "fa-sort-down" : "fa-sort-up");

        <th class="@cellClass">
            <a href="@($"{CustomerRankFilter.BaseUrl}{Model.Filter.SortQuery(field)}")" class="inline-flex items-center gap-1">
                <span>@L[labelKey]</span>
                <i class="fa-solid @icon @(isCurrent ? null : "text-muted")" aria-hidden="true"></i>
            </a>
        </th>
    }
}
<div class="overflow-x-auto">
    <table class="tbl tbl-cards">
        <thead>
            <tr>
                <th class="num">#</th>
                @{ SortHeader(CustomerRankFilter.SortByName, "Reports_Customers_Name"); }
                <th>@L["Reports_Customers_Type"]</th>
                <th>@L["Reports_Customers_Tier"]</th>
                @{ SortHeader(CustomerRankFilter.SortByContracts, "Reports_Customers_Contracts", "num"); }
                @{ SortHeader(CustomerRankFilter.SortByValue, "Reports_Customers_Value", "num"); }
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var row = Model.Rows[i];
                <tr>
                    <td class="num" data-label="#">@(Model.FirstRowNumber + i)</td>
                    <td data-label="@L["Reports_Customers_Name"]">
                        <a href="/customers/@row.CustomerId" class="font-medium hover:underline">@row.CustomerName</a>
                    </td>
                    <td data-label="@L["Reports_Customers_Type"]">@L.Label("CustomerType", row.CustomerType)</td>
                    <td data-label="@L["Reports_Customers_Tier"]">
                        <partial name="_Badge" model="BadgeModel.Tier(row.Tier)" />
                    </td>
                    <td class="num" data-label="@L["Reports_Customers_Contracts"]">@row.ContractCount</td>
                    <td class="num" data-label="@L["Reports_Customers_Value"]">@Utils.FormatMoney(row.TotalValue)</td>
                </tr>
            }
        </tbody>
    </table>
</div>