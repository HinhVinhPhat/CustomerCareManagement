@model RevenueReportViewModel
@{
    ViewData["Title"] = L["Nav_Reports"];
    ViewData["PageKey"] = "reports";

    var yearFilter = new YearFilterModel("/reports/revenue", Model.Year, Model.Years);
    var exportLink = new ExportLinkModel(
        $"/reports/revenue/export?year={Model.Year}", "Reports_ExportRevenue");
}

<header class="mb-5">
    <h1 class="text-2xl font-bold">@L["Nav_Reports"]</h1>
    <p class="text-sm text-muted mt-1">@L["Reports_Revenue_Subtitle", Model.Year]</p>
</header>

<partial name="_Tabs" model="WorkConstants.Reports.TabRevenue" />

<div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <partial name="_YearFilter" model="yearFilter" />
    <partial name="_ExportButton" model="exportLink" />
</div>

@if (Model.ErrorKey is not null)
{
    <section class="card">
        <partial name="_BlockError" model="Model.ErrorKey" />
    </section>
}
else
{
    <section class="card p-5 mb-4">
        <div class="flex items-start justify-between gap-3 mb-4">
            <h2 class="font-semibold">@L["Reports_Revenue_Chart", Model.Year]</h2>
            <span class="text-sm text-muted">@Utils.FormatMoney(Model.Total)</span>
        </div>

        @{
            var labels = Model.Rows
                .Select(row => CultureInfo.CurrentUICulture.DateTimeFormat.GetAbbreviatedMonthName(row.Month))
                .ToList();
            var values = Model.Rows.Select(row => row.Revenue).ToList();
            var chart = new BarChartModel(
                L["Reports_Revenue_Chart", Model.Year].Value, labels, values);
        }

        <partial name="Charts/_BarChart" model="chart" />
    </section>

    <section class="card overflow-hidden">
        <partial name="_RevenueTable" model="Model" />
    </section>
}
